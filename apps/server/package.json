{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.mjs",
    "db:auth:generate":"bun x auth generate --config=../../packages/auth/src/index.ts --output=../../packages/db/src/schema/auth.ts --yes"

  },
  "dependencies": {
    "@hono/node-server": "^1.14.4",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "@tanisya/api": "workspace:*",
    "@tanisya/auth": "workspace:*",
    "@tanisya/db": "workspace:*",
    "@tanisya/env": "workspace:*",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tanisya/config": "workspace:*",
    "@types/node": "^22.13.14",
    "tsdown": "^0.21.9",
    "tsx": "^4.19.2",
    "typescript": "catalog:"
  }
}
